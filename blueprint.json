{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "AND Perceelscheck",
    "description": "Testomgeving voor de Perceelscheck-plugin",
    "author": "Eye Entertainment"
  },
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "landingPage": "/",
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/eye87/AND/main/agrarische-natuur-drenthe-kaart-1.3.3.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; $page_id = wp_insert_post(array('post_title' => 'Perceelscheck', 'post_name' => 'perceelscheck', 'post_content' => '[perceelscheck]', 'post_status' => 'publish', 'post_type' => 'page')); update_option('show_on_front', 'page'); update_option('page_on_front', $page_id);"
    }
  ]
}
